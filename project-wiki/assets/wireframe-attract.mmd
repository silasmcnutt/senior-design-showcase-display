flowchart TB
    subgraph AttractMode["Attract Mode - Full Screen"]
        direction TB
        Header["┌─────────────────────────────────────────────┐"]
        Title["│  SENIOR DESIGN SHOWCASE                     │"]
        Subtitle["│  CSE Department - Past Capstone Projects    │"]
        HeaderEnd["└─────────────────────────────────────────────┘"]
        
        Carousel["┌─────────────────────────────────────────────┐"]
        HeroImage["│  [HERO IMAGE / VIDEO - 1920x1080]           │"]
        CarouselInfo["│  Ken Burns pan/zoom effect                  │"]
