        ProjEnd["└─────────────────────────────────────────────┘"]
        
        Prompt["┌─────────────────────────────────────────────┐"]
        PromptText["│  ██████████████████████████████████████████  │"]
        PromptMsg["│  Touch anywhere to explore projects ►       │"]
        PromptEnd["└─────────────────────────────────────────────┘"]
        
        Dots["● ○ ○ ○ ○  (5 projects rotating)"]
