    Header --> Title --> Subtitle --> HeaderEnd
    HeaderEnd --> Carousel
    Carousel --> HeroImage --> CarouselInfo --> CarouselEnd
    CarouselEnd --> ProjectInfo
    ProjectInfo --> ProjTitle --> ProjYear --> ProjTags --> ProjEnd
    ProjEnd --> Prompt
    Prompt --> PromptText --> PromptMsg --> PromptEnd
    PromptEnd --> Dots

    style AttractMode fill:#1a1a2e,stroke:#e94560,stroke-width:2px
    style Header fill:#16213e,stroke:#0f3460
    style Carousel fill:#16213e,stroke:#0f3460
    style ProjectInfo fill:#16213e,stroke:#0f3460
    style Prompt fill:#e94560,stroke:#ff6b6b
